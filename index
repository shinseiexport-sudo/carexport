<script>
function showLang(code) {
  document.querySelectorAll('.lang-block').forEach(el => el.style.display = 'none');
  document.getElementById('lang-' + code).style.display = 'block';

  document.querySelectorAll('.lang-switch button').forEach(btn => btn.classList.remove('active'));
  event.target.classList.add('active');
}

document.getElementById("buyerForm").addEventListener("submit", function(e){
